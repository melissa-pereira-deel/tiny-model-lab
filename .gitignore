# Artifacts and corpora: provenance is committed, bytes are not.
runs/*/artifacts/
runs/*/checkpoints/
data/
corpora/
champion/*.onnx
champion/*.mlpackage/
champion/*.tflite
champion/*.safetensors
*.pt
*.pth
*.ckpt
*.gguf

# Manifests and ledgers ARE tracked — they are the decision trail.
!runs/*/manifest.json
!runs/LEDGER.md
!runs/SESSIONS.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

