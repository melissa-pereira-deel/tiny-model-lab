# Artifacts and corpora: provenance is committed, bytes are not.
runs/*/artifacts/
runs/*/checkpoints/
data/
corpora/
champion/*.onnx
champion/*.mlpackage/
champion/*.tflite
champion/*.safetensors
*.pt
*.pth
*.ckpt
*.gguf

# Manifests and ledgers ARE tracked — they are the decision trail.
!runs/*/manifest.json
!runs/LEDGER.md
!runs/SESSIONS.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/

# OS
.DS_Store

# Generated by running the examples. Both of these are ignored whole, including
# the manifests, cards and ledgers that would be kept at the repo root — an
# example's promotion history is output, not this repo's decision trail, and it
# is rewritten on every CI run. The champion rules above cannot cover this: they
# contain a slash, so git anchors them to the root and they never reach
# examples/. Do not close that by broadening them to **/champion/ — the root's
# champion.json and LEDGER.md are tracked on purpose (#28).
examples/*/runs/
examples/*/champion/

# Exports of the .claude/ layer into other agent formats. .claude/ is the
# source; committing copies would mean two divergent log-run.sh in one repo.
.agents/
.codex/
