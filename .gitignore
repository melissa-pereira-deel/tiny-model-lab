# Artifacts and corpora: provenance is committed, bytes are not.
runs/*/artifacts/
runs/*/checkpoints/
data/
corpora/
champion/*.onnx
champion/*.mlpackage/
champion/*.tflite
champion/*.safetensors
*.pt
*.pth
*.ckpt
*.gguf

# Manifests and ledgers ARE tracked — they are the decision trail.
!runs/*/manifest.json
!runs/LEDGER.md
!runs/SESSIONS.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/

# OS
.DS_Store

# Generated by running the examples
examples/*/runs/

# Exports of the .claude/ layer into other agent formats. .claude/ is the
# source; committing copies would mean two divergent log-run.sh in one repo.
.agents/
.codex/
